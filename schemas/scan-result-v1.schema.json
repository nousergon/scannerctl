{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nousergon/scannerctl/schemas/scan-result-v1.schema.json",
  "title": "scannerctl scan result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict"],
  "properties": {
    "schema_version": {"const": "1"},
    "verdict": {"enum": ["clean", "block", "error", "disabled"]},
    "backend": {"type": "string"},
    "backend_version": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^$|^[a-f0-9]{64}$"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "bytes_scanned": {"type": "integer", "minimum": 0},
    "target_id": {"type": "string"},
    "rule_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
